// Cloudflare Workers の設定 — https://developers.cloudflare.com/workers/wrangler/configuration/
//
// 秘密情報はここに書かない。`wrangler secret put SPOTIFY_CLIENT_ID` などで設定する
// （一覧は .dev.vars.example）。
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spotify-embedded",
	"main": "src/worker.ts",
	"compatibility_date": "2025-09-15",
	// Buffer / node:crypto と、秘密情報を process.env に入れるために必要
	"compatibility_flags": [
		"nodejs_compat"
	],
	// デモ画面と embed.js。Worker より先に配信される（ヘッダーは public/_headers）
	"assets": {
		"directory": "./public"
	},
	// ムード文の保存先。KV の namespace ID はアカウントごとに異なるので、id は書かない。
	// 初回の `wrangler deploy` で Wrangler が namespace を自動作成して MOODS にバインドし、
	// 2回目以降はデプロイ済みの Worker の MOODS バインディング（同じ namespace）を引き継ぐ。
	// https://developers.cloudflare.com/workers/wrangler/configuration/#automatic-provisioning
	"kv_namespaces": [
		{
			"binding": "MOODS"
		}
	],
	// IPごとに 60 秒あたり 100 リクエストまで（Node 版の src/index.ts も同じ値）
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 100,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	}
}