// Cloudflare Workers の設定 — https://developers.cloudflare.com/workers/wrangler/configuration/
//
// 秘密情報はここに書かない。`wrangler secret put SPOTIFY_CLIENT_ID` などで設定する
// （一覧は .dev.vars.example）。
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spotify-embedded",
	"main": "src/worker.ts",
	"compatibility_date": "2025-09-15",
	// Buffer / node:crypto と、秘密情報を process.env に入れるために必要
	"compatibility_flags": [
		"nodejs_compat"
	],
	// デモ画面と embed.js。Worker より先に配信される（ヘッダーは public/_headers）
	"assets": {
		"directory": "./public"
	},
	// ムード文の保存先。この id は作者の Cloudflare アカウントの namespace（ID はアカウントごと）。
	// フォークして自分のアカウントにデプロイする場合は `npx wrangler kv namespace create MOODS`
	// で作成し、表示された id に差し替える（手順は README「Cloudflare Workers」）。
	"kv_namespaces": [
		{
			"binding": "MOODS",
			"id": "154260f7bedf4f4ca2d290b41b9c5e67"
		}
	],
	// IPごとに 60 秒あたり 100 リクエストまで
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 100,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	}
}