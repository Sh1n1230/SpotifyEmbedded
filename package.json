{
  "name": "spotify-embedded",
  "version": "1.3.0",
  "description": "Spotifyの再生状況を、AIが生成した日本語のムード文つきでポートフォリオやREADMEに埋め込む。サーバー不要の静的生成にも対応。",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sh1n1230/SpotifyEmbedded.git"
  },
  "bugs": {
    "url": "https://github.com/Sh1n1230/SpotifyEmbedded/issues"
  },
  "homepage": "https://github.com/Sh1n1230/SpotifyEmbedded#readme",
  "bin": {
    "spotify-embedded": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "wrangler dev",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy",
    "setup": "tsx src/cli/index.ts setup",
    "generate": "tsx src/cli/index.ts generate",
    "auth": "ENABLE_AUTH_ROUTES=true tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "spotify",
    "api",
    "portfolio",
    "now-playing",
    "github-readme",
    "svg",
    "embed",
    "gemini",
    "llm",
    "mood",
    "github-profile",
    "cloudflare-workers"
  ],
  "author": "Shin Nakamura",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "dotenv": "^18.0.5",
    "hono": "^4.13.12",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "fast-xml-parser": "^5.11.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.2"
  },
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
