# ── Spotify ──────────────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard でアプリを作成し、
# Redirect URI に http://127.0.0.1:3000/auth/callback を登録（localhost は不可）
# 値は空のままにしておくと、`npm run setup` が入力を求めて書き込みます
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# `npm run setup` が自動で取得します（手動入力は不要）
SPOTIFY_REFRESH_TOKEN=

# ── LLM（ムード文の生成・任意） ──────────────────────────────────────────────
# OpenAI互換のAPIなら何でも使えます。未設定でもムード文なしで動作します。
# 推奨: Google Gemini（無料枠あり） https://aistudio.google.com/apikey
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.1-flash-lite

# ── 任意（本番運用向け） ──────────────────────────────────────────────────────
# 埋め込み先サイトに限定することを推奨（既定: *）
# CORS_ORIGIN=https://yoursite.com