# ── Spotify ──────────────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard でアプリを作成し、
# Redirect URI に http://127.0.0.1:3000/auth/callback を登録（localhost は不可）
# 値は空のままにしておくと、`npm run setup` が入力を求めて書き込みます
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# `npm run setup` が自動で取得します（手動入力は不要）
SPOTIFY_REFRESH_TOKEN=

# ── LLM（ムード文の生成・任意） ──────────────────────────────────────────────
# OpenAI互換のAPIなら何でも使えます。未設定でもムード文なしで動作します。
# 推奨: Google Gemini（無料枠あり） https://aistudio.google.com/apikey
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.1-flash-lite

# ── 任意（本番運用向け） ──────────────────────────────────────────────────────
# 埋め込み先サイトに限定することを推奨（既定: *）。カンマ区切りで複数書ける
# CORS_ORIGIN=https://yoursite.com,https://blog.yoursite.com
# 待受ポート（既定: 3000）。変えると SPOTIFY_REDIRECT_URI の既定も変わる
# PORT=3000
# 待ち受けるホスト（既定: すべて。npm run auth では 127.0.0.1）
# HOST=127.0.0.1
# Dashboard の Redirect URI と一致させる（既定: http://127.0.0.1:<PORT>/auth/callback）
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# リバースプロキシ配下のレート制限で、クライアントIPとして使うヘッダー（プロキシが必ず上書きする構成でだけ）
# TRUSTED_PROXY_HEADER=x-forwarded-for
# 認証情報の保存先（既定: data/auth.json）
# AUTH_STORE_PATH=data/auth.json
# 本番相当では production（CORS_ORIGIN が * のままなら起動時に警告する）
# NODE_ENV=production
